# — Desarrollo local —

# Tu Postgres local
DATABASE_URL="postgresql://postgres:clave@localhost:5432/ecommerce"

# Redis local (opcional en dev — sin esta variable el rate limiter usa memoria)
# Levanta Redis con: docker run -p 6379:6379 redis:7-alpine
# REDIS_URL="redis://localhost:6379"

# Generar con: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales del primer administrador (usadas por el seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Carpeta donde se guardan las imágenes subidas (solo si NO usas R2)
UPLOADS_DIR="./data/uploads"

# Cloudflare R2 (opcional) — si se configura, las imágenes van a R2 en vez del disco.
# R2_ACCOUNT_ID: dashboard de Cloudflare → R2 (arriba a la derecha)
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage API Tokens → token con "Object Read & Write"
# R2_PUBLIC_URL: URL pública del bucket (pub-xxxx.r2.dev o tu dominio), sin / al final
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="ecommerce"
# R2_PUBLIC_URL=""

# Correo transaccional via Gmail SMTP (límite 500/día en cuenta gratuita).
# Necesitas verificación en 2 pasos activa. Crea la contraseña de aplicación en:
#   myaccount.google.com → Seguridad → Contraseñas de aplicaciones
# El EMAIL_FROM tiene que usar el mismo correo de SMTP_USER.
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tucorreo@gmail.com"
# SMTP_PASS=""    # contraseña de 16 caracteres, sin espacios
# EMAIL_FROM="Mercado Vecino <tucorreo@gmail.com>"
#
# Protege el endpoint /api/cron/vencimientos. Generar con: openssl rand -hex 32
# CRON_SECRET=""

# Wompi (opcional) — pasarela para cobrar suscripciones. Sin estas llaves la UI
# de Wompi se oculta y solo queda el pago manual (ver MANUAL_PAYMENT en src/lib/config.ts).
# Llaves en comercios.wompi.co → Desarrolladores. Usa pub_test_/prv_test_ para sandbox.
# WOMPI_PUBLIC_KEY=""
# WOMPI_PRIVATE_KEY=""
# WOMPI_INTEGRITY_SECRET=""
# WOMPI_EVENTS_SECRET=""    # configura también la URL de eventos: https://tudominio/api/wompi/eventos

# "1" crea un conjunto y negocio de prueba al correr el seed
SEED_DEMO="1"

# — Producción (VPS) —
# El .env del VPS necesita estas variables además de las de arriba.
# DATABASE_URL, BETTER_AUTH_URL y UPLOADS_DIR no hacen falta: el compose los define.

# DOMAIN="midominio.com"
# POSTGRES_USER="ecommerce"
# POSTGRES_PASSWORD=""   # openssl rand -hex 16
# POSTGRES_DB="ecommerce"

# Umami analytics (opcional) — panel de visitas auto-hospedado en stats.tudominio.com.
# STATS_DOMAIN="stats.midominio.com"
# UMAMI_DB_USER="umami"
# UMAMI_DB_PASSWORD=""          # openssl rand -hex 16
# UMAMI_APP_SECRET=""           # openssl rand -base64 32
#
# Después de crear el sitio en Umami, añade el Website ID:
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://stats.midominio.com/script.js"
